# Copy to .env (never commit it) and fill in.
# 1. In Telegram, talk to @BotFather, send /newbot, follow the steps, copy the token here.
TELEGRAM_BOT_TOKEN=
# 2. Leave this empty on the first start: message the bot and it tells you your numeric user ID. Put it here and restart.
TELEGRAM_ALLOWED_USER_ID=
# Messages sent within this many seconds of each other are grouped into one listing.
GROUP_WINDOW_SECONDS=180
