# Copy to .env (never commit it) and fill in.
# What you are buying: a folder in domains/ (see domains/README.md).
DOMAIN=campervan
# 1. In Telegram, talk to @BotFather, send /newbot, follow the steps, copy the token here.
TELEGRAM_BOT_TOKEN=
# 2. Leave this empty on the first start: message the bot and it tells you your numeric user ID. Put it here and restart.
TELEGRAM_ALLOWED_USER_ID=
# Messages sent within this many seconds of each other are grouped into one listing.
GROUP_WINDOW_SECONDS=180
# AI analysis with Claude Code, using your Claude subscription:
#   off     only save what you send (the default)
#   manual  analyse when you send /done
#   auto    also analyse by itself once GROUP_WINDOW_SECONDS have passed since your last message
ANALYSIS=auto
# Who does the analysis:
#   claude-code  Claude Code on your Claude subscription (the default; nothing else to set up)
#   anthropic    Claude API, paid per use: ANTHROPIC_API_KEY, and `uv sync --extra anthropic` (or `pip install anthropic`)
#   openai       OpenAI API: OPENAI_API_KEY and MODEL, and `uv sync --extra openai`
#   openrouter   any model on OpenRouter: OPENROUTER_API_KEY and MODEL, and `uv sync --extra openai`
PROVIDER=claude-code
# The model. claude-code: opus or sonnet (default opus). anthropic: default claude-opus-5-5.
# openai / openrouter: required, the provider's model id (it must accept images and JSON-schema output).
MODEL=
# API providers only. EFFORT (Claude API: low / medium / high, or none to leave it out; default medium).
# PRICE_PER_MTOK="input,output" in USD per million tokens, for a cost estimate in /usage (OpenRouter reports cost).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
EFFORT=
PRICE_PER_MTOK=
# Full path to the claude program if the bot can't find it (systemd has a short PATH). `which claude` shows it.
CLAUDE_BIN=
# Linux PC only: run `claude setup-token` there and paste the token here (remove the #). Not needed on the Mac.
# CLAUDE_CODE_OAUTH_TOKEN=
# When the bot sends its morning digest (waiting sellers, top listings, market moves), local time as HH:MM.
# Empty or "off" turns it off. /digest sends it on request.
DIGEST_TIME=09:00
# Optional: copy each analysed listing to a Google Sheet (setup: deploy/google-sheet.md). Leave empty to skip.
GOOGLE_SHEET_URL=
GOOGLE_SHEET_SECRET=
# The spreadsheet's own address (https://docs.google.com/spreadsheets/d/...), for the "Open sheet" button and /sheet.
GOOGLE_SHEET_LINK=
