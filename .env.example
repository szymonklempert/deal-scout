# Copy to .env (never commit it) and fill in.
# What you are buying: a folder in domains/ (see domains/README.md).
DOMAIN=campervan
# 1. In Telegram, talk to @BotFather, send /newbot, follow the steps, copy the token here.
TELEGRAM_BOT_TOKEN=
# 2. Leave this empty on the first start: message the bot and it tells you your numeric user ID. Put it here and restart.
TELEGRAM_ALLOWED_USER_ID=
# Messages sent within this many seconds of each other are grouped into one listing.
GROUP_WINDOW_SECONDS=180
# AI analysis with Claude Code, using your Claude subscription:
#   off     only save what you send (the default)
#   manual  analyse when you send /done
#   auto    also analyse by itself once GROUP_WINDOW_SECONDS have passed since your last message
ANALYSIS=auto
# Model for the analysis: opus (best at reading numbers) or sonnet (lighter on your usage limits).
CLAUDE_MODEL=opus
# Full path to the claude program if the bot can't find it (systemd has a short PATH). `which claude` shows it.
CLAUDE_BIN=
# Linux PC only: run `claude setup-token` there and paste the token here (remove the #). Not needed on the Mac.
# CLAUDE_CODE_OAUTH_TOKEN=
# Optional: copy each analysed listing to a Google Sheet (setup: deploy/google-sheet.md). Leave empty to skip.
GOOGLE_SHEET_URL=
GOOGLE_SHEET_SECRET=
# The spreadsheet's own address (https://docs.google.com/spreadsheets/d/...), for the "Open sheet" button and /sheet.
GOOGLE_SHEET_LINK=
